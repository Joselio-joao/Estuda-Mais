# Ambiente da aplicação Estuda+
# Copie para .env e substitua os valores entre parênteses. Nunca envie o ficheiro .env para o Git.

# Aplicação Expo
APP_NAME=Estuda+
APP_SLUG=estudamais
APP_SCHEME=estudamais
APP_BUNDLE_ID=com.estudamais.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# API e dados
PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://<utilizador>:<palavra-passe>@<servidor>:3306/<base-de-dados>
# Aiven e outros MySQL geridos exigem TLS. Cole o CA PEM numa só linha, usando \n para cada quebra.
DATABASE_SSL=false
DATABASE_CA_PEM=
JWT_SECRET=<gere-um-segredo-aleatorio-longo>
# Domínios separados por vírgula autorizados a chamar a API em produção.
CORS_ORIGIN=https://<utilizador>.github.io

# Proprietário inicial e administração
BOOTSTRAP_OWNER_EMAIL=<email-do-proprietario>
OWNER_OPEN_ID=<identificador-do-proprietario>
EXPO_PUBLIC_OWNER_OPEN_ID=<identificador-do-proprietario>
EXPO_PUBLIC_OWNER_NAME=<nome-do-proprietario>

# Autenticação OIDC — substituir pelo fornecedor sob controlo do proprietário
OAUTH_SERVER_URL=https://<servidor-oidc>
EXPO_PUBLIC_OAUTH_SERVER_URL=https://<servidor-oidc>
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://<portal-da-aplicacao>

# Funcionalidades de IA — opcional, configurar apenas quando existir fornecedor próprio
BUILT_IN_FORGE_API_URL=https://<fornecedor-de-ia>
BUILT_IN_FORGE_API_KEY=<chave-do-fornecedor-de-ia>
